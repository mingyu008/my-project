# Spring API origin. The session cookie and CSRF token are handled by src/api/client.ts.
VITE_API_BASE_URL=http://localhost:8080
# Test-mode sign-in (nickname only). Default: "true" for npm run dev, "false" for builds/tests (vite.config.ts).
# Must match the backend's app.auth.test-mode; setting AUTH_TEST_MODE in the shell switches both.
# VITE_AUTH_TEST_MODE=true
